# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Virtual env
.venv/
venv/
env/

# Logs
*.log

# Run outputs
result/

# Generated visualization
figures/
*.html

# Keep source HTML
!web/index.html
!docs/**/*.html

# Demo media (local only)
/media/demos/*.mp4
/media/demos/*.avi
/media/demos/*.mov
/*.mp4
/*.avi
/*.mov

# Temp / backup
*.old
*.bak
*.json.bak
*.html.bak

# Generated images: ignore by default, keep data/ inputs
*.png
*.jpg
!data/**/*.png
!data/**/*.jpg
